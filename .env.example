# ==============================================================================
# HazeWatch SEA — Environment Configuration
# ==============================================================================

# NASA FIRMS (Fire Information for Resource Management System) Map Key
# Free registration: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# This key is strictly accessed by Next.js Server Route Handlers and never leaked to the client.
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Optional: Custom cache TTL in seconds (defaults: AQI=1800, Hotspots=3600)
CACHE_TTL_AIR_QUALITY=1800
CACHE_TTL_HOTSPOTS=3600
